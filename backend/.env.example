# Connection string da Neon (Settings > Connection Details no dashboard).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Só o access token é JWT — o refresh é opaco (token aleatório, hash SHA-256
# no banco, revogável apagando a linha) e não precisa de secret próprio.
# Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="troque-por-um-valor-aleatorio-de-verdade"

PORT=3000

# Ligue APENAS quando houver proxy confiável na frente (Fly.io, nginx). O rate
# limit chaveia por IP: sem isso, atrás de proxy o tráfego inteiro cai num balde
# só; com isso e sem proxy, qualquer um forja o IP de origem via X-Forwarded-For.
# Ligado, o app confia em UM salto de proxy (ver `trustProxy` em `app.ts`) e usa
# o endereço que esse proxy observou, ignorando o resto da cadeia.
TRUST_PROXY=false
