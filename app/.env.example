# URL base do backend. Expo injeta variáveis EXPO_PUBLIC_* no bundle em build time.
#
# Emulador Android (AVD): o host da máquina é acessível em 10.0.2.2, não localhost.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Celular físico na mesma rede Wi-Fi: use o IP local da máquina que roda o backend.
# EXPO_PUBLIC_API_URL=http://192.168.0.X:3000
